{
  "name": "@carbon/ai-chat-examples-demo",
  "private": true,
  "version": "1.23.0",
  "type": "module",
  "description": "A demo and testing framework using @carbon/ai-chat as a React component.",
  "scripts": {
    "generate:carbon-registration": "node tasks/generate-carbon-registration.mjs",
    "prestart": "npm run generate:carbon-registration",
    "start": "vite",
    "prebuild": "npm run generate:carbon-registration",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS='--import ./tests/node-polyfill.js' playwright test"
  },
  "author": "IBM Corp",
  "license": "Apache-2.0",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "dependencies": {
    "@carbon/ai-chat": "^1.23.0",
    "@carbon/ai-chat-components": "^1.13.0",
    "@carbon/icons": "^12.0.0-alpha.1",
    "@carbon/react": "^2.0.0-alpha.3",
    "@carbon/web-components": "^3.0.0-alpha.3",
    "lit": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.14",
    "@vitejs/plugin-react": "^6.0.0",
    "accessibility-checker": "^4.0.18",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
