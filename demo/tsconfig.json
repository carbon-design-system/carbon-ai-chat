{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "plugins": [
      {
        "name": "ts-lit-plugin"
      }
    ]
  },
  "include": [
    "src/**/*",
    "types/**/*.d.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}
