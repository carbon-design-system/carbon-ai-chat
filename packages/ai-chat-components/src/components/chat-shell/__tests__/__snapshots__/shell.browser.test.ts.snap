// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cds-aichat-shell > Snapshots > should match snapshot with all properties enabled 1`] = `
<cds-aichat-shell
  ai-enabled=""
  corner-all="round"
  history-location="start"
  show-frame=""
  show-history=""
  show-workspace=""
  workspace-in-panel=""
  workspace-location="start"
>
</cds-aichat-shell>

`;

exports[`cds-aichat-shell > Snapshots > should match snapshot with default configuration 1`] = `
<cds-aichat-shell
  corner-all="square"
  history-location="start"
  workspace-location="start"
>
</cds-aichat-shell>

`;

exports[`cds-aichat-shell > Snapshots > should match snapshot with mixed corner configuration 1`] = `
<cds-aichat-shell
  corner-all="square"
  corner-end-end="round"
  corner-start-start="round"
  history-location="start"
  workspace-location="start"
>
</cds-aichat-shell>

`;

exports[`cds-aichat-shell > Snapshots > should match snapshot with rounded corners 1`] = `
<cds-aichat-shell
  corner-all="round"
  history-location="start"
  workspace-location="start"
>
</cds-aichat-shell>

`;
